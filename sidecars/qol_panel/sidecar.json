{
  "command": "./run-sidecar",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Desktop QoL",
  "description": "Configure custom wallpaper, flat UI, and session stats bar for Antigravity Desktop.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Desktop QoL",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Desktop QoL"
      }
    ]
  }
}
